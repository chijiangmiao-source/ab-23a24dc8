# Host port the API is published on (container always listens on 8000).
API_HOST_PORT=8080
# Host port PostgreSQL is published on.
POSTGRES_HOST_PORT=5432
# Fixed container name used by the verify service to exercise restart recovery.
API_CONTAINER_NAME=pulse-api

POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse

# Staging window: fragments up to water_mark + WINDOW_AHEAD are accepted.
WINDOW_AHEAD=32
